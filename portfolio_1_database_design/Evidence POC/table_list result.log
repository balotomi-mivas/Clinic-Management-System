Indexes:
    "appointment_pkey" PRIMARY KEY, btree (appointment_id)
    "no_double_booking" EXCLUDE USING gist (doctor_id WITH =, tstzrange(scheduled_at, ends_at) WITH &&) WHERE (status::text <> ALL (ARRAY['CANCELLED'::character varying, 'NO_SHOW'::character varying]::text[]))
Check constraints:
    "appointment_check" CHECK (ends_at > scheduled_at)
    "appointment_slot_minutes_check" CHECK (slot_minutes >= 5 AND slot_minutes <= 120)
    "appointment_status_check" CHECK (status::text = ANY (ARRAY['BOOKED'::character varying, 'CHECKED_IN'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying, 'NO_SHOW'::character varying]::text[]))
